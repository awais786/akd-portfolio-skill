# AKD portfolio settings. Optional: the portfolio command works with just AKD_USER_ID and AKD_PASSWORD
# in your shell environment. Precedence: real environment variables > .env > built-in defaults.
# Format: plain KEY=VALUE, one per line. No quotes, no spaces around '=', no inline comments.
# NEVER put AKD_PASSWORD in this file: it would be plain text on disk. Export it in your shell.

# Accounts (put real values in `.env`, never here; the first account is AKD_USER_ID / AKD_PASSWORD):
# AKD_USER_ID_1=COAF00000
# AKD_PASSWORD_1=
# AKD_USER_ID_2=
# AKD_PASSWORD_2=
# AKD_USER_ID_3=
# AKD_PASSWORD_3=

# AKD endpoints (change only if AKD moves them; see docs/PROTOCOL-MAP.md)
# AKD_SOAP_URL=http://online.akdtrade.biz/TradeCastServicev428/LoginServerService
