# AKD portfolio settings. Copy this file to `.env` (git-ignored) and fill it in, or export the same
# variables in your shell. Precedence: real environment variables > .env > built-in defaults.
# Format: plain KEY=VALUE, one per line. Comments on their own lines only.
# `.env` holds your password in PLAIN TEXT: `chmod 600 .env`, keep it on a machine you trust, and never
# commit it, paste it or put real values in THIS example file.

# Accounts (the first account is AKD_USER_ID / AKD_PASSWORD):
# AKD_USER_ID_1=COAF00000
# AKD_PASSWORD_1=
# AKD_USER_ID_2=
# AKD_PASSWORD_2=
# AKD_USER_ID_3=
# AKD_PASSWORD_3=

# AKD endpoints (change only if AKD moves them; see docs/PROTOCOL-MAP.md)
# AKD_SOAP_URL=http://online.akdtrade.biz/TradeCastServicev428/LoginServerService
