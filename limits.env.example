# Order limits for the ticket check and the approval hook. NOT a secret file: never put a password or PIN here.
# Copy to `limits.env` (git-ignored) and edit. A real environment variable of the same name wins over this file.
# A value that is missing, not a number, infinite, or not above zero falls back to the default: never to "no limit".

# Most PKR value of one order (shares x limit price).
AKD_TICKET_MAX_VALUE=100000
# Most shares in one order.
AKD_TICKET_MAX_QTY=10000
# How far (in %) a limit price may be from AKD's price (--ref) before it is treated as a typo.
AKD_TICKET_PRICE_BAND_PCT=10
# Cash headroom (in %) kept for fees and taxes when checking a BUY. 0 is allowed.
AKD_TICKET_FEE_BUFFER_PCT=1
